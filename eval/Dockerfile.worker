bash node:22-alpine

WORKDIR /app

COPY package.json .

RUN apk add --no-cache bash chafa

RUN npm install --omit=dev \
    && npm cache clean --force

COPY eval-server.js .

RUN addgroup -S worker \
    && adduser -S worker -G worker \
    && chown -R worker:worker /app

USER worker

CMD ["node", "eval-server.js", "worker"]
